{
  "name": "timehunt-graybox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stage 4 gray-box of the Daily Ten. No dependencies. Throw-away UI, portable engine.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve": "node scripts/serve.mjs",
    "demo": "node scripts/demo-run.mjs",
    "record": "node scripts/record-video.mjs",
    "lint": "eslint src motion reveal scripts test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contracts.json",
    "verify": "npm run lint && npm run typecheck && npm test",
    "build:sw": "node scripts/build-sw.mjs",
    "e2e:offline": "node scripts/e2e-offline.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3"
  }
}

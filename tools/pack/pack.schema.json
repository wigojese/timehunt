{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIMEHUNT daily pack (draft schema, Stage 3)",
  "type": "object",
  "required": [
    "pack_id",
    "version",
    "status",
    "date_convention",
    "sources",
    "cases",
    "connections",
    "finale_thesis"
  ],
  "properties": {
    "status": {
      "enum": [
        "DRAFT_NOT_PUBLISHABLE",
        "REVIEW",
        "PUBLISHABLE"
      ]
    },
    "date_convention": {
      "const": "end-of-year"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "kind",
          "opened",
          "retrieved"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "title",
          "lens",
          "region",
          "question",
          "corridor",
          "target",
          "free",
          "paid",
          "reveal",
          "editorial"
        ],
        "properties": {
          "corridor": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "target": {
            "type": "object",
            "required": [
              "year",
              "event",
              "definition",
              "precision",
              "calendar",
              "discovery_vs_event"
            ]
          },
          "free": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "anchor",
                "predicate",
                "convention",
                "source_ids",
                "kind"
              ]
            }
          },
          "paid": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "anchor",
                "predicate",
                "tier",
                "cost",
                "category",
                "source_ids"
              ],
              "properties": {
                "tier": {
                  "enum": [
                    "nudge",
                    "deep"
                  ]
                },
                "cost": {
                  "enum": [
                    1,
                    2
                  ]
                }
              }
            }
          },
          "editorial": {
            "type": "object",
            "required": [
              "c0",
              "uniqueness_proof",
              "paid_effects",
              "fragment_levels",
              "blockers",
              "publishable",
              "facts",
              "hold",
              "sample_player"
            ],
            "properties": {
              "c0": {
                "type": "array",
                "minItems": 3,
                "maxItems": 6
              }
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "after_case",
          "title",
          "text"
        ]
      }
    }
  }
}
